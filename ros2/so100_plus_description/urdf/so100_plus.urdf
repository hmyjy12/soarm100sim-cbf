  <joint name="shoulder_rotation_joint" type="revolute">
    <parent link="base"/>
    <child link="shoulder_rotation"/>
    <origin xyz="0.0612 0 0.0623" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.2" upper="2.2" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_rotation"/>
    <child link="shoulder_pitch"/>
    <origin xyz="0.0306 0 0.0542" rpy="-1.57080057 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14158" upper="0.2" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

  <joint name="ellbow_joint" type="revolute">
    <parent link="shoulder_pitch"/>
    <child link="ellbow"/>
    <origin xyz="0.11257 0.028 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.14158" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="ellbow"/>
    <child link="wrist_pitch"/>
    <origin xyz="0.1349 -0.0052 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.0" upper="1.8" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

  <joint name="wrist_jaw_joint" type="revolute">
    <parent link="wrist_pitch"/>
    <child link="wrist_jaw"/>
    <origin xyz="0.0345 0 -0.0012" rpy="1.57080057 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.45" upper="1.45" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_jaw"/>
    <child link="wrist_roll"/>
    <origin xyz="0.0488 0 -0.0075" rpy="3.14159265 1.57079208 3.14159265"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14158" upper="3.14158" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

  <joint name="gripper_joint" type="revolute">
    <parent link="wrist_roll"/>
    <child link="gripper"/>
    <origin xyz="-0.020398 0.0012 0.0248" rpy="1.57080057 -1.44194115e-12 -3.14158531"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.2" upper="2.0" effort="35" velocity="1"/>
    <dynamics friction="0.1"/>
  </joint>

</robot>
