      <origin xyz="0.0054721 0.00096004 0.028413" rpy="0.415554923 0.0370211925 1.53969727"/>
      <mass value="0.093165"/>
      <inertia ixx="5.03437e-05" ixy="0" ixz="0" iyy="4.64877e-05" iyz="0" izz="2.73546e-05"/>
